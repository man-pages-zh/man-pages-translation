#, no-wrap
msgid "4.3.3 "
msgstr "4.3.3 "

#. type: tbl table
#: raw/findutils/man1/locate.1:252
#, no-wrap
msgid " locate I<-i> supports multi-byte characters correctly"
msgstr " locate I<-i> 正确支持多字节字符"

#. type: tbl table
#: raw/findutils/man1/locate.1:253
#, no-wrap
msgid " Introduced I<--max_db_age>"
msgstr " 引入 I<--max_db_age>"

#. type: tbl table
#: raw/findutils/man1/locate.1:254
#, no-wrap
msgid "4.3.2 "
msgstr "4.3.2 "

#. type: tbl table
#: raw/findutils/man1/locate.1:254
#, no-wrap
msgid " Support for the slocate database format"
msgstr " 支持 slocate 数据库格式"

#. type: tbl table
#: raw/findutils/man1/locate.1:255
#, no-wrap
msgid "4.2.22"
msgstr "4.2.22"

#. type: tbl table
#: raw/findutils/man1/locate.1:255
#, no-wrap
msgid " Introduced the I<--all> option"
msgstr " 引入 I<--all> 选项"

#. type: tbl table
#: raw/findutils/man1/locate.1:256
#, no-wrap
msgid "4.2.15"
