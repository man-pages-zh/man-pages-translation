#. type: TH
#: raw/iproute2/man8/ss.8:1
#, no-wrap
msgid "SS"
msgstr "SS"

#. type: SH
#: raw/iproute2/man8/ss.8:2
#, no-wrap
msgid "NAME"
msgstr "名称"

#. type: Plain text
#: raw/iproute2/man8/ss.8:4
msgid "ss - another utility to investigate sockets"
msgstr "ss - 另一个用于查看套接字的工具"

#. type: SH
#: raw/iproute2/man8/ss.8:4
#, no-wrap
msgid "SYNOPSIS"
msgstr "概述"

#. type: Plain text
#: raw/iproute2/man8/ss.8:7
msgid "B<ss> [I<options>]I< [ FILTER ]>"
msgstr "B<ss> [I<选项>]I< [ 过滤器 ]>"

#. type: SH
#: raw/iproute2/man8/ss.8:7
#, no-wrap
msgid "DESCRIPTION"
msgstr "描述"

#. type: Plain text
#: raw/iproute2/man8/ss.8:13
msgid ""
"B<ss> is used to dump socket statistics. It allows showing information "
"similar to I<netstat>.  It can display more TCP and state information "
"than other tools."
msgstr "B<ss> 用于转储套接字统计信息。它可以显示类似于 I<netstat> 的信息。与其他工具相比，它可以显示更多的 TCP 和状态信息。"

#. type: SH
#: raw/iproute2/man8/ss.8:14
#, no-wrap
msgid "OPTIONS"
msgstr "选项"

#. type: Plain text
#: raw/iproute2/man8/ss.8:17
msgid ""
"When no option is used ss displays a list of open non-listening sockets "
"(e.g. TCP/UNIX/UDP) that have established connections."
msgstr "未使用任何选项时，ss 会显示已建立连接的开放非监听套接字列表（例如 TCP/UNIX/UDP）。"

#. type: TP
#: raw/iproute2/man8/ss.8:17
#, no-wrap
msgid "B<-h, --help>"
msgstr "B<-h, --help>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:20
msgid "Show summary of options."
msgstr "显示选项摘要。"

#. type: TP
#: raw/iproute2/man8/ss.8:20
#, no-wrap
msgid "B<-V, --version>"
msgstr "B<-V, --version>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:23
msgid "Output version information."
msgstr "输出版本信息。"

#. type: TP
#: raw/iproute2/man8/ss.8:23
#, no-wrap
msgid "B<-H, --no-header>"
msgstr "B<-H, --no-header>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:26
msgid "Suppress header line."
msgstr "抑制标题行。"

#. type: TP
#: raw/iproute2/man8/ss.8:26
#, no-wrap
msgid "B<-Q, --no-queues>"
msgstr "B<-Q, --no-queues>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:29
msgid "Suppress sending and receiving queue columns."
msgstr "隐藏发送队列和接收队列两列。"

#. type: TP
#: raw/iproute2/man8/ss.8:29
#, no-wrap
msgid "B<-O, --oneline>"
msgstr "B<-O, --oneline>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:32
msgid "Print each socket's data on a single line."
msgstr "将每个套接字的数据打印在一行上。"

#. type: TP
#: raw/iproute2/man8/ss.8:32
#, no-wrap
msgid "B<-n, --numeric>"
msgstr "B<-n, --numeric>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:35
msgid ""
"Do not try to resolve service names. Show exact bandwidth values, instead"
" of human-readable values."
msgstr "不要尝试解析服务名。显示精确的带宽值，而不是人类可读的值。"

#. type: TP
#: raw/iproute2/man8/ss.8:35
#, no-wrap
msgid "B<-r, --resolve>"
msgstr "B<-r, --resolve>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:38
msgid "Try to resolve numeric address/ports."
msgstr "尝试解析数字地址/端口。"

#. type: TP
#: raw/iproute2/man8/ss.8:38
#, no-wrap
msgid "B<-a, --all>"
msgstr "B<-a, --all>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:42
msgid ""
"Display both listening and non-listening (for TCP this means established "
"connections) sockets."
msgstr "显示监听和非监听（对于 TCP，这意味着已建立连接）套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:42
#, no-wrap
msgid "B<-l, --listening>"
msgstr "B<-l, --listening>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:45
msgid "Display only listening sockets (these are omitted by default)."
msgstr "仅显示监听套接字（默认情况下会省略这些）。"

#. type: TP
#: raw/iproute2/man8/ss.8:45
#, no-wrap
msgid "B<-B, --bound-inactive>"
msgstr "B<-B, --bound-inactive>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:49
msgid ""
"Display only TCP bound but inactive (not listening, connecting, etc.) "
"sockets (these are omitted by default)."
msgstr "仅显示已绑定但处于非活动状态的 TCP 套接字（未监听、未连接等）（默认情况下会省略这些）。"

#. type: TP
#: raw/iproute2/man8/ss.8:49
#, no-wrap
msgid "B<-o, --options>"
msgstr "B<-o, --options>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:52
msgid "Show timer information. For TCP protocol, the output format is:"
msgstr "显示定时器信息。对于 TCP 协议，输出格式为："

#. type: Plain text
#: raw/iproute2/man8/ss.8:55
msgid "timer:(E<lt>timer_nameE<gt>,E<lt>expire_timeE<gt>,E<lt>retransE<gt>)"
msgstr "timer:(E<lt>timer_nameE<gt>,E<lt>expire_timeE<gt>,E<lt>retransE<gt>)"

#. type: TP
#: raw/iproute2/man8/ss.8:56
#, no-wrap
msgid "B<E<lt>timer_nameE<gt>>"
msgstr "B<E<lt>timer_nameE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:59
msgid "the name of the timer, there are five kinds of timer names:"
msgstr "定时器的名称，共有五种定时器名称："

#. type: Plain text
#: raw/iproute2/man8/ss.8:64
msgid ""
"B<on> : means one of these timers: TCP retrans timer, TCP early retrans "
"timer and tail loss probe timer"
msgstr "B<on>：表示以下定时器之一：TCP 重传定时器、TCP 提前重传定时器和尾丢失探测定时器"

#. type: Plain text
#: raw/iproute2/man8/ss.8:66
msgid "B<keepalive>: tcp keep alive timer"
msgstr "B<keepalive>：TCP 保活定时器"

#. type: Plain text
#: raw/iproute2/man8/ss.8:68
msgid "B<timewait>: timewait stage timer"
msgstr "B<timewait>：TIME_WAIT 阶段定时器"

#. type: Plain text
#: raw/iproute2/man8/ss.8:70
msgid "B<persist>: zero window probe timer"
msgstr "B<persist>：零窗口探测定时器"

#. type: Plain text
#: raw/iproute2/man8/ss.8:72
msgid "B<unknown>: none of the above timers"
msgstr "B<unknown>：以上定时器都不是"

#. type: TP
#: raw/iproute2/man8/ss.8:73
#, no-wrap
msgid "B<E<lt>expire_timeE<gt>>"
msgstr "B<E<lt>expire_timeE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:76
msgid "how long until the timer will expire"
msgstr "距离定时器到期还有多长时间"

#. type: TP
#: raw/iproute2/man8/ss.8:77
#, no-wrap
msgid "B<E<lt>retransE<gt>>"
msgstr "B<E<lt>retransE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:80
msgid "how many times retransmissions have occurred"
msgstr "已发生重传的次数"

#. type: TP
#: raw/iproute2/man8/ss.8:81
#, no-wrap
msgid "B<-e, --extended>"
msgstr "B<-e, --extended>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:84
msgid "Show detailed socket information. The output format is:"
msgstr "显示详细的套接字信息。输出格式为："

#. type: Plain text
#: raw/iproute2/man8/ss.8:87
msgid "uid:E<lt>uid_numberE<gt> ino:E<lt>inode_numberE<gt> sk:E<lt>cookieE<gt>"
msgstr "uid:E<lt>uid_numberE<gt> ino:E<lt>inode_numberE<gt> sk:E<lt>cookieE<gt>"

#. type: TP
#: raw/iproute2/man8/ss.8:88
#, no-wrap
msgid "B<E<lt>uid_numberE<gt>>"
msgstr "B<E<lt>uid_numberE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:91
msgid "the user id the socket belongs to"
msgstr "套接字所属的用户 ID"

#. type: TP
#: raw/iproute2/man8/ss.8:92
#, no-wrap
msgid "B<E<lt>inode_numberE<gt>>"
msgstr "B<E<lt>inode_numberE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:95
msgid "the socket's inode number in VFS"
msgstr "套接字在 VFS 中的 inode 编号"

#. type: TP
#: raw/iproute2/man8/ss.8:96
#, no-wrap
msgid "B<E<lt>cookieE<gt>>"
msgstr "B<E<lt>cookieE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:99
msgid "a uuid of the socket"
msgstr "套接字的 UUID"

#. type: TP
#: raw/iproute2/man8/ss.8:100
#, no-wrap
msgid "B<-m, --memory>"
msgstr "B<-m, --memory>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:103
msgid "Show socket memory usage. The output format is:"
msgstr "显示套接字内存使用情况。输出格式为："

#. type: Plain text
#: raw/iproute2/man8/ss.8:106
msgid "skmem:(rE<lt>rmem_allocE<gt>,rbE<lt>rcv_bufE<gt>,tE<lt>wmem_allocE<gt>,tbE<lt>snd_bufE<gt>,"
msgstr "skmem:(rE<lt>rmem_allocE<gt>,rbE<lt>rcv_bufE<gt>,tE<lt>wmem_allocE<gt>,tbE<lt>snd_bufE<gt>,"

#. type: Plain text
#: raw/iproute2/man8/ss.8:110
msgid "fE<lt>fwd_allocE<gt>,wE<lt>wmem_queuedE<gt>,oE<lt>opt_memE<gt>,"
msgstr "fE<lt>fwd_allocE<gt>,wE<lt>wmem_queuedE<gt>,oE<lt>opt_memE<gt>,"

#. type: Plain text
#: raw/iproute2/man8/ss.8:116
msgid "blE<lt>back_logE<gt>,dE<lt>sock_dropE<gt>)"
msgstr "blE<lt>back_logE<gt>,dE<lt>sock_dropE<gt>)"

#. type: TP
#: raw/iproute2/man8/ss.8:119
#, no-wrap
msgid "B<E<lt>rmem_allocE<gt>>"
msgstr "B<E<lt>rmem_allocE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:122
msgid "the memory allocated for receiving packets"
msgstr "为接收数据包分配的内存量"

#. type: TP
#: raw/iproute2/man8/ss.8:123
#, no-wrap
msgid "B<E<lt>rcv_bufE<gt>>"
msgstr "B<E<lt>rcv_bufE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:126
msgid "the total memory that can be allocated for receiving packets"
msgstr "可用于接收数据包的总内存量"

#. type: TP
#: raw/iproute2/man8/ss.8:127
#, no-wrap
msgid "B<E<lt>wmem_allocE<gt>>"
msgstr "B<E<lt>wmem_allocE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:130
msgid "the memory used for sending packets (which has been sent to layer 3)"
msgstr "用于发送数据包的内存量（已发送到第 3 层）"

#. type: TP
#: raw/iproute2/man8/ss.8:131
#, no-wrap
msgid "B<E<lt>snd_bufE<gt>>"
msgstr "B<E<lt>snd_bufE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:134
msgid "the total memory that can be allocated for sending packets"
msgstr "可用于发送数据包的总内存量"

#. type: TP
#: raw/iproute2/man8/ss.8:135
#, no-wrap
msgid "B<E<lt>fwd_allocE<gt>>"
msgstr "B<E<lt>fwd_allocE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:141
msgid ""
"the memory allocated by the socket as cache, but not used for "
"receiving/sending packets yet. If memory is needed to send/receive "
"packets, the memory in this cache will be used before allocating "
"additional memory."
msgstr "套接字作为缓存分配但尚未用于接收/发送数据包的内存量。如果需要内存来发送/接收数据包，会先使用此缓存中的内存，然后再分配额外内存。"

#. type: TP
#: raw/iproute2/man8/ss.8:142
#, no-wrap
msgid "B<E<lt>wmem_queuedE<gt>>"
msgstr "B<E<lt>wmem_queuedE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:145
msgid ""
"The memory allocated for sending packets (which has not been sent to "
"layer 3)"
msgstr "为发送数据包分配的内存量（尚未发送到第 3 层）"

#. type: TP
#: raw/iproute2/man8/ss.8:146
#, no-wrap
msgid "B<E<lt>opt_memE<gt>>"
msgstr "B<E<lt>opt_memE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:149
msgid ""
"The memory used for storing socket options, e.g., the key for TCP MD5 "
"signature"
msgstr "用于存储套接字选项的内存量，例如 TCP MD5 签名密钥"

#. type: TP
#: raw/iproute2/man8/ss.8:150
#, no-wrap
msgid "B<E<lt>back_logE<gt>>"
msgstr "B<E<lt>back_logE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:156
msgid ""
"The memory used for the sk backlog queue. On a process context, if the "
"process is receiving packets, and a new packet is received, it will be "
"put into the sk backlog queue, so it can be received by the process "
"immediately."
msgstr ""
"用于 sk backlog 队列的内存量。在进程上下文中，如果进程正在接收数据包，并且收到新数据包，该数据包会被放入 sk backlog "
"队列，以便进程立即接收。"

#. type: TP
#: raw/iproute2/man8/ss.8:157
#, no-wrap
msgid "B<E<lt>sock_dropE<gt>>"
msgstr "B<E<lt>sock_dropE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:160
msgid ""
"the number of packets dropped before they are de-multiplexed into the "
"socket"
msgstr "在数据包被解复用到套接字之前丢弃的数据包数量"

#. type: TP
#: raw/iproute2/man8/ss.8:161
#, no-wrap
msgid "B<-p, --processes>"
msgstr "B<-p, --processes>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:164
msgid "Show processes using sockets."
msgstr "显示使用套接字的进程。"

#. type: TP
#: raw/iproute2/man8/ss.8:164
#, no-wrap
msgid "B<-T, --threads>"
msgstr "B<-T, --threads>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:168
msgid "Show threads using sockets. Implies B<-p>."
msgstr "显示使用套接字的线程。隐含启用 B<-p>。"

#. type: TP
#: raw/iproute2/man8/ss.8:168
#, no-wrap
msgid "B<-i, --info>"
msgstr "B<-i, --info>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:171
msgid "Show internal TCP information. Below fields may appear:"
msgstr "显示内部 TCP 信息。可能出现以下字段："

#. type: TP
#: raw/iproute2/man8/ss.8:173
#, no-wrap
msgid "B<ts>"
msgstr "B<ts>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:176
msgid "show string \"ts\" if the timestamp option is set"
msgstr "如果设置了时间戳选项，则显示字符串 \"ts\""

#. type: TP
#: raw/iproute2/man8/ss.8:177
#, no-wrap
msgid "B<sack>"
msgstr "B<sack>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:180
msgid "show string \"sack\" if the sack option is set"
msgstr "如果设置了 sack 选项，则显示字符串 \"sack\""

#. type: TP
#: raw/iproute2/man8/ss.8:181
#, no-wrap
msgid "B<ecn>"
msgstr "B<ecn>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:184
msgid "show string \"ecn\" if the explicit congestion notification option is set"
msgstr "如果设置了显式拥塞通知选项，则显示字符串 \"ecn\""

#. type: TP
#: raw/iproute2/man8/ss.8:185
#, no-wrap
msgid "B<ecnseen>"
msgstr "B<ecnseen>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:188
msgid "show string \"ecnseen\" if the saw ecn flag is found in received packets"
msgstr "如果在接收到的数据包中发现 ecn 标志，则显示字符串 \"ecnseen\""

#. type: TP
#: raw/iproute2/man8/ss.8:189
#, no-wrap
msgid "B<fastopen>"
msgstr "B<fastopen>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:192
msgid "show string \"fastopen\" if the fastopen option is set"
msgstr "如果设置了 fastopen 选项，则显示字符串 \"fastopen\""

#. type: TP
#: raw/iproute2/man8/ss.8:193
#, no-wrap
msgid "B<cong_alg>"
msgstr "B<cong_alg>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:196
msgid ""
"the congestion algorithm name, the default congestion algorithm is "
"\"cubic\""
msgstr "拥塞算法名称，默认拥塞算法为 \"cubic\""

#. type: TP
#: raw/iproute2/man8/ss.8:197
#, no-wrap
msgid "B<wscale:E<lt>snd_wscaleE<gt>:E<lt>rcv_wscaleE<gt>>"
msgstr "B<wscale:E<lt>snd_wscaleE<gt>:E<lt>rcv_wscaleE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:201
msgid ""
"if window scale option is used, this field shows the send scale factor "
"and receive scale factor"
msgstr "如果使用了窗口缩放选项，此字段显示发送缩放因子和接收缩放因子"

#. type: TP
#: raw/iproute2/man8/ss.8:202
#, no-wrap
msgid "B<rto:E<lt>icsk_rtoE<gt>>"
msgstr "B<rto:E<lt>icsk_rtoE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:205
msgid "tcp re-transmission timeout value, the unit is millisecond"
msgstr "TCP 重传超时值，单位为毫秒"

#. type: TP
#: raw/iproute2/man8/ss.8:206
#, no-wrap
msgid "B<backoff:E<lt>icsk_backoffE<gt>>"
msgstr "B<backoff:E<lt>icsk_backoffE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:210
msgid ""
"used for exponential backoff re-transmission, the actual re-transmission "
"timeout value is icsk_rto E<lt>E<lt> icsk_backoff"
msgstr "用于指数退避重传，实际重传超时值为 icsk_rto E<lt>E<lt> icsk_backoff"

#. type: TP
#: raw/iproute2/man8/ss.8:211
#, no-wrap
msgid "B<rtt:E<lt>rttE<gt>/E<lt>rttvarE<gt>>"
msgstr "B<rtt:E<lt>rttE<gt>/E<lt>rttvarE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:215
msgid ""
"rtt is the average round trip time, rttvar is the mean deviation of rtt, "
"their units are millisecond"
msgstr "rtt 是平均往返时间，rttvar 是 rtt 的平均偏差，它们的单位都是毫秒"

#. type: TP
#: raw/iproute2/man8/ss.8:216
#, no-wrap
msgid "B<ato:E<lt>atoE<gt>>"
msgstr "B<ato:E<lt>atoE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:219
msgid "ack timeout, unit is millisecond, used for delay ack mode"
msgstr "ACK 超时，单位为毫秒，用于延迟 ACK 模式"

#. type: TP
#: raw/iproute2/man8/ss.8:220
#, no-wrap
msgid "B<mss:E<lt>mssE<gt>>"
msgstr "B<mss:E<lt>mssE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:223
msgid "max segment size"
msgstr "最大段大小"

#. type: TP
#: raw/iproute2/man8/ss.8:224
#, no-wrap
msgid "B<cwnd:E<lt>cwndE<gt>>"
msgstr "B<cwnd:E<lt>cwndE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:227
msgid "congestion window size"
msgstr "拥塞窗口大小"

#. type: TP
#: raw/iproute2/man8/ss.8:228
#, no-wrap
msgid "B<pmtu:E<lt>pmtuE<gt>>"
msgstr "B<pmtu:E<lt>pmtuE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:231
msgid "path MTU value"
msgstr "路径 MTU 值"

#. type: TP
#: raw/iproute2/man8/ss.8:232
#, no-wrap
msgid "B<ssthresh:E<lt>ssthreshE<gt>>"
msgstr "B<ssthresh:E<lt>ssthreshE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:235
msgid "tcp congestion window slow start threshold"
msgstr "TCP 拥塞窗口慢启动阈值"

#. type: TP
#: raw/iproute2/man8/ss.8:236
#, no-wrap
msgid "B<bytes_acked:E<lt>bytes_ackedE<gt>>"
msgstr "B<bytes_acked:E<lt>bytes_ackedE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:239
msgid "bytes acked"
msgstr "已确认的字节数"

#. type: TP
#: raw/iproute2/man8/ss.8:240
#, no-wrap
msgid "B<bytes_received:E<lt>bytes_receivedE<gt>>"
msgstr "B<bytes_received:E<lt>bytes_receivedE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:243
msgid "bytes received"
msgstr "已接收的字节数"

#. type: TP
#: raw/iproute2/man8/ss.8:244
#, no-wrap
msgid "B<segs_out:E<lt>segs_outE<gt>>"
msgstr "B<segs_out:E<lt>segs_outE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:247
msgid "segments sent out"
msgstr "已发送的段数"

#. type: TP
#: raw/iproute2/man8/ss.8:248
#, no-wrap
msgid "B<segs_in:E<lt>segs_inE<gt>>"
msgstr "B<segs_in:E<lt>segs_inE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:251
msgid "segments received"
msgstr "已接收的段数"

#. type: TP
#: raw/iproute2/man8/ss.8:252
#, no-wrap
msgid "B<send E<lt>send_bpsE<gt>bps>"
msgstr "B<send E<lt>send_bpsE<gt>bps>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:255
msgid "egress bps"
msgstr "出站 bps"

#. type: TP
#: raw/iproute2/man8/ss.8:256
#, no-wrap
msgid "B<lastsnd:E<lt>lastsndE<gt>>"
msgstr "B<lastsnd:E<lt>lastsndE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:259
msgid "how long it has been since the last packet sent, the unit is millisecond"
msgstr "距离上次发送数据包已经过去的时间，单位为毫秒"

#. type: TP
#: raw/iproute2/man8/ss.8:260
#, no-wrap
msgid "B<lastrcv:E<lt>lastrcvE<gt>>"
msgstr "B<lastrcv:E<lt>lastrcvE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:263
msgid ""
"how long it has been since the last packet received, the unit is "
"millisecond"
msgstr "距离上次接收数据包已经过去的时间，单位为毫秒"

#. type: TP
#: raw/iproute2/man8/ss.8:264
#, no-wrap
msgid "B<lastack:E<lt>lastackE<gt>>"
msgstr "B<lastack:E<lt>lastackE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:267
msgid "how long it has been since the last ack received, the unit is millisecond"
msgstr "距离上次收到 ACK 已经过去的时间，单位为毫秒"

#. type: TP
#: raw/iproute2/man8/ss.8:268
#, no-wrap
msgid "B<pacing_rate E<lt>pacing_rateE<gt>bps/E<lt>max_pacing_rateE<gt>bps>"
msgstr "B<pacing_rate E<lt>pacing_rateE<gt>bps/E<lt>max_pacing_rateE<gt>bps>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:271
msgid "the pacing rate and max pacing rate"
msgstr "发送速率和最大发送速率"

#. type: TP
#: raw/iproute2/man8/ss.8:272
#, no-wrap
msgid "B<rcv_space:E<lt>rcv_spaceE<gt>>"
msgstr "B<rcv_space:E<lt>rcv_spaceE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:275
msgid "a helper variable for TCP internal auto tuning socket receive buffer"
msgstr "用于 TCP 内部自动调整套接字接收缓冲区的辅助变量"

#. type: TP
#: raw/iproute2/man8/ss.8:276
#, no-wrap
msgid ""
"B<tcp-ulp-mptcp flags:[MmBbJjecv] "
"token:E<lt>rem_token(rem_id)/loc_token(loc_id)E<gt> seq:E<lt>snE<gt> "
"sfseq:E<lt>ssnE<gt> ssnoff:E<lt>offE<gt> maplen:E<lt>maplenE<gt>>"
msgstr ""
"B<tcp-ulp-mptcp flags:[MmBbJjecv] "
"token:E<lt>rem_token(rem_id)/loc_token(loc_id)E<gt> seq:E<lt>snE<gt> "
"sfseq:E<lt>ssnE<gt> ssnoff:E<lt>offE<gt> maplen:E<lt>maplenE<gt>>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:279
msgid "MPTCP subflow information"
msgstr "MPTCP 子流信息"

#. type: TP
#: raw/iproute2/man8/ss.8:281
#, no-wrap
msgid "B<--tos>"
msgstr "B<--tos>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:284
msgid "Show ToS and priority information. Below fields may appear:"
msgstr "显示 ToS 和优先级信息。可能出现以下字段："

#. type: TP
#: raw/iproute2/man8/ss.8:286
#, no-wrap
msgid "B<tos>"
msgstr "B<tos>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:289
msgid "IPv4 Type-of-Service byte"
msgstr "IPv4 服务类型字节"

#. type: TP
#: raw/iproute2/man8/ss.8:290
#, no-wrap
msgid "B<tclass>"
msgstr "B<tclass>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:293
msgid "IPv6 Traffic Class byte"
msgstr "IPv6 流量类别字节"

#. type: TP
#: raw/iproute2/man8/ss.8:294
#, no-wrap
msgid "B<class_id>"
msgstr "B<class_id>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:298
msgid ""
"Class id set by net_cls cgroup. If class is zero this shows priority set "
"by SO_PRIORITY."
msgstr "由 net_cls cgroup 设置的类 ID。如果类为零，则显示由 SO_PRIORITY 设置的优先级。"

#. type: TP
#: raw/iproute2/man8/ss.8:299
#, no-wrap
msgid "B<--cgroup>"
msgstr "B<--cgroup>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:302
msgid "Show cgroup information. Below fields may appear:"
msgstr "显示 cgroup 信息。可能出现以下字段："

#. type: TP
#: raw/iproute2/man8/ss.8:304
#, no-wrap
msgid "B<cgroup>"
msgstr "B<cgroup>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:307
msgid ""
"Cgroup v2 pathname. This pathname is relative to the mount point of the "
"hierarchy."
msgstr "Cgroup v2 路径名。此路径名相对于层级结构的挂载点。"

#. type: TP
#: raw/iproute2/man8/ss.8:308
#, no-wrap
msgid "B<--tipcinfo>"
msgstr "B<--tipcinfo>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:311
msgid "Show internal tipc socket information."
msgstr "显示内部 TIPC 套接字信息。"

#. type: TP
#: raw/iproute2/man8/ss.8:311
#, no-wrap
msgid "B<-K, --kill>"
msgstr "B<-K, --kill>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:316
msgid ""
"Attempts to forcibly close sockets. This option displays sockets that are"
" successfully closed and silently skips sockets that the kernel does not "
"support closing. It supports IPv4 and IPv6 sockets only."
msgstr "尝试强制关闭套接字。此选项会显示成功关闭的套接字，并静默跳过内核不支持关闭的套接字。它仅支持 IPv4 和 IPv6 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:316
#, no-wrap
msgid "B<-s, --summary>"
msgstr "B<-s, --summary>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:321
msgid ""
"Print summary statistics. This option does not parse socket lists "
"obtaining summary from various sources. It is useful when amount of "
"sockets is so huge that parsing /proc/net/tcp is painful."
msgstr "打印汇总统计信息。此选项不解析套接字列表，而是从各种来源获取汇总信息。当套接字数量巨大，解析 /proc/net/tcp 很痛苦时，此选项很有用。"

#. type: TP
#: raw/iproute2/man8/ss.8:321
#, no-wrap
msgid "B<-E, --events>"
msgstr "B<-E, --events>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:324
msgid "Continually display sockets as they are destroyed"
msgstr "在套接字被销毁时持续显示它们"

#. type: TP
#: raw/iproute2/man8/ss.8:324
#, no-wrap
msgid "B<-Z, --context>"
msgstr "B<-Z, --context>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:331
msgid ""
"As the B<-p> option but also shows process security context. If the B<-T>"
" option is used, also shows thread security context."
msgstr "与 B<-p> 选项类似，但还会显示进程安全上下文。如果使用了 B<-T> 选项，还会显示线程安全上下文。"

#. type: Plain text
#: raw/iproute2/man8/ss.8:335
msgid ""
"For B<netlink>(7)  sockets the initiating process context is displayed as"
" follows:"
msgstr "对于 B<netlink>(7) 套接字，发起进程上下文的显示方式如下："

#. type: IP
#: raw/iproute2/man8/ss.8:337
#, no-wrap
msgid "1."
msgstr "1."

#. type: Plain text
#: raw/iproute2/man8/ss.8:339
msgid "If valid pid show the process context."
msgstr "如果 pid 有效，则显示进程上下文。"

#. type: IP
#: raw/iproute2/man8/ss.8:339
#, no-wrap
msgid "2."
msgstr "2."

#. type: Plain text
#: raw/iproute2/man8/ss.8:341
msgid "If destination is kernel (pid = 0) show kernel initial context."
msgstr "如果目标是内核（pid = 0），则显示内核初始上下文。"

#. type: IP
#: raw/iproute2/man8/ss.8:341
#, no-wrap
msgid "3."
msgstr "3."

#. type: Plain text
#: raw/iproute2/man8/ss.8:345
msgid ""
"If a unique identifier has been allocated by the kernel or netlink user, "
"show context as \"unavailable\". This will generally indicate that a "
"process has more than one netlink socket active."
msgstr ""
"如果内核或 netlink 用户已分配唯一标识符，则将上下文显示为 \"unavailable\"。这通常表示某个进程有多个活动的 netlink"
" 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:347
#, no-wrap
msgid "B<-z, --contexts>"
msgstr "B<-z, --contexts>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:357
msgid ""
"As the B<-Z> option but also shows the socket context. The socket context"
" is taken from the associated inode and is not the actual socket context "
"held by the kernel. Sockets are typically labeled with the context of the"
" creating process, however the context shown will reflect any policy "
"role, type and/or range transition rules applied, and is therefore a "
"useful reference."
msgstr ""
"与 B<-Z> 选项类似，但还会显示套接字上下文。套接字上下文取自关联的 "
"inode，而不是内核持有的实际套接字上下文。套接字通常使用创建进程的上下文进行标记，但显示的上下文会反映所应用的任何策略角色、类型和/或范围转换规则，因此是有用的参考。"

#. type: TP
#: raw/iproute2/man8/ss.8:357
#, no-wrap
msgid "B<-N NSNAME, --net=NSNAME>"
msgstr "B<-N NSNAME, --net=NSNAME>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:360
msgid "Switch to the specified network namespace name."
msgstr "切换到指定的网络命名空间名称。"

#. type: TP
#: raw/iproute2/man8/ss.8:360
#, no-wrap
msgid "B<-b, --bpf>"
msgstr "B<-b, --bpf>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:364
msgid ""
"Show socket classic BPF filters (only administrators are allowed to get "
"this information)."
msgstr "显示套接字经典 BPF 过滤器（只有管理员才能获取此信息）。"

#. type: TP
#: raw/iproute2/man8/ss.8:364
#, no-wrap
msgid "B<-4, --ipv4>"
msgstr "B<-4, --ipv4>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:367
msgid "Display only IP version 4 sockets (alias for -f inet)."
msgstr "仅显示 IP 版本 4 套接字（-f inet 的别名）。"

#. type: TP
#: raw/iproute2/man8/ss.8:367
#, no-wrap
msgid "B<-6, --ipv6>"
msgstr "B<-6, --ipv6>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:370
msgid "Display only IP version 6 sockets (alias for -f inet6)."
msgstr "仅显示 IP 版本 6 套接字（-f inet6 的别名）。"

#. type: TP
#: raw/iproute2/man8/ss.8:370
#, no-wrap
msgid "B<-0, --packet>"
msgstr "B<-0, --packet>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:373
msgid "Display PACKET sockets (alias for -f link)."
msgstr "显示 PACKET 套接字（-f link 的别名）。"

#. type: TP
#: raw/iproute2/man8/ss.8:373
#, no-wrap
msgid "B<-t, --tcp>"
msgstr "B<-t, --tcp>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:376
msgid "Display TCP sockets."
msgstr "显示 TCP 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:376
#, no-wrap
msgid "B<-u, --udp>"
msgstr "B<-u, --udp>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:379
msgid "Display UDP sockets."
msgstr "显示 UDP 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:379
#, no-wrap
msgid "B<-w, --raw>"
msgstr "B<-w, --raw>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:382
msgid "Display RAW sockets."
msgstr "显示 RAW 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:382
#, no-wrap
msgid "B<-x, --unix>"
msgstr "B<-x, --unix>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:385
msgid "Display Unix domain sockets (alias for -f unix)."
msgstr "显示 Unix 域套接字（-f unix 的别名）。"

#. type: TP
#: raw/iproute2/man8/ss.8:385
#, no-wrap
msgid "B<-S, --sctp>"
msgstr "B<-S, --sctp>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:388
msgid "Display SCTP sockets."
msgstr "显示 SCTP 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:388
#, no-wrap
msgid "B<--tipc>"
msgstr "B<--tipc>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:391
msgid "Display tipc sockets (alias for -f tipc)."
msgstr "显示 tipc 套接字（-f tipc 的别名）。"

#. type: TP
#: raw/iproute2/man8/ss.8:391
#, no-wrap
msgid "B<--vsock>"
msgstr "B<--vsock>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:394
msgid "Display vsock sockets (alias for -f vsock)."
msgstr "显示 vsock 套接字（-f vsock 的别名）。"

#. type: TP
#: raw/iproute2/man8/ss.8:394
#, no-wrap
msgid "B<--xdp>"
msgstr "B<--xdp>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:397
msgid "Display XDP sockets (alias for -f xdp)."
msgstr "显示 XDP 套接字（-f xdp 的别名）。"

#. type: TP
#: raw/iproute2/man8/ss.8:397
#, no-wrap
msgid "B<-M, --mptcp>"
msgstr "B<-M, --mptcp>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:400
msgid "Display MPTCP sockets."
msgstr "显示 MPTCP 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:400
#, no-wrap
msgid "B<--inet-sockopt>"
msgstr "B<--inet-sockopt>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:403
msgid "Display inet socket options."
msgstr "显示 inet 套接字选项。"

#. type: TP
#: raw/iproute2/man8/ss.8:403
#, no-wrap
msgid "B<-f FAMILY, --family=FAMILY>"
msgstr "B<-f FAMILY, --family=FAMILY>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:407
msgid ""
"Display sockets of type FAMILY.  Currently the following families are "
"supported: unix, inet, inet6, link, netlink, vsock, tipc, xdp."
msgstr "显示 FAMILY 类型的套接字。目前支持以下类型：unix、inet、inet6、link、netlink、vsock、tipc、xdp。"

#. type: TP
#: raw/iproute2/man8/ss.8:407
#, no-wrap
msgid "B<-A QUERY, --query=QUERY, --socket=QUERY>"
msgstr "B<-A QUERY, --query=QUERY, --socket=QUERY>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:416
msgid ""
"List of socket tables to dump, separated by commas. The following "
"identifiers are understood: all, inet, tcp, udp, raw, unix, packet, "
"netlink, unix_dgram, unix_stream, unix_seqpacket, packet_raw, "
"packet_dgram, sctp, tipc, vsock_stream, vsock_dgram, xdp, mptcp. Any item"
" in the list may optionally be prefixed by an exclamation mark (B<!>)  to"
" exclude that socket table from being dumped."
msgstr "要转储的套接字表列表，以逗号分隔。可以识别以下标识符：all、inet、tcp、udp、raw、unix、packet、netlink、unix_dgram、unix_stream、unix_seqpacket、packet_raw、packet_dgram、sctp、tipc、vsock_stream、vsock_dgram、xdp、mptcp。列表中的任何项都可以选择以感叹号（B<!>）为前缀，以将该套接字表排除在转储之外。"

#. type: TP
#: raw/iproute2/man8/ss.8:416
#, no-wrap
msgid "B<-D FILE, --diag=FILE>"
msgstr "B<-D FILE, --diag=FILE>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:420
msgid ""
"Do not display anything, just dump raw information about TCP sockets to "
"FILE after applying filters. If FILE is - stdout is used."
msgstr "不显示任何内容，只在应用过滤器后将 TCP 套接字的原始信息转储到 FILE。如果 FILE 为 -，则使用标准输出。"

#. type: TP
#: raw/iproute2/man8/ss.8:420
#, no-wrap
msgid "B<-F FILE, --filter=FILE>"
msgstr "B<-F FILE, --filter=FILE>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:424
msgid ""
"Read filter information from FILE.  Each line of FILE is interpreted like"
" single command line option. If FILE is - stdin is used."
msgstr "从 FILE 读取过滤信息。FILE 的每一行都像单个命令行选项一样解释。如果 FILE 为 -，则使用标准输入。"

#. type: TP
#: raw/iproute2/man8/ss.8:424
#, no-wrap
msgid "B<--bpf-maps>"
msgstr "B<--bpf-maps>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:427
msgid "Pretty-print all the BPF socket-local data entries for each socket."
msgstr "美化打印每个套接字的所有 BPF 套接字本地数据条目。"

#. type: TP
#: raw/iproute2/man8/ss.8:427
#, no-wrap
msgid "B<--bpf-map-id=MAP_ID>"
msgstr "B<--bpf-map-id=MAP_ID>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:430
msgid ""
"Pretty-print the BPF socket-local data entries for the requested map ID. "
"Can be used more than once."
msgstr "美化打印所请求映射 ID 的 BPF 套接字本地数据条目。可以多次使用。"

#. type: TP
#: raw/iproute2/man8/ss.8:430
#, no-wrap
msgid "B<FILTER := [ state STATE-FILTER ] [ EXPRESSION ]>"
msgstr "B<FILTER := [ state STATE-FILTER ] [ EXPRESSION ]>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:433
msgid ""
"Please take a look at the official documentation for details regarding "
"filters."
msgstr "有关过滤器的详细信息，请参阅官方文档。"

#. type: SH
#: raw/iproute2/man8/ss.8:434
#, no-wrap
msgid "STATE-FILTER"
msgstr "状态过滤器"

#. type: Plain text
#: raw/iproute2/man8/ss.8:440
msgid ""
"B<STATE-FILTER> allows one to construct an arbitrary set of states to "
"match. Its syntax is sequence of keywords state and exclude followed by "
"identifier of state."
msgstr "B<STATE-FILTER> 允许构造任意要匹配的状态集合。其语法是关键字 state 和 exclude 的序列，后跟状态标识符。"

#. type: TP
#: raw/iproute2/man8/ss.8:440
#, no-wrap
msgid "Available identifiers are:"
msgstr "可用的标识符有："

#. type: Plain text
#: raw/iproute2/man8/ss.8:446
msgid ""
"All standard TCP states: B<established>, B<syn-sent>, B<syn-recv>, B<fin-"
"wait-1>, B<fin-wait-2>, B<time-wait>, B<closed>, B<close-wait>, B<last-"
"ack>, B<listening> and B<closing.>"
msgstr ""
"所有标准 TCP 状态：B<established>、B<syn-sent>、B<syn-recv>、B<fin-wait-1>、B<fin-"
"wait-2>、B<time-wait>、B<closed>、B<close-wait>、B<last-ack>、B<listening> 和 "
"B<closing>。"

#. type: Plain text
#: raw/iproute2/man8/ss.8:449
msgid "B<all> - for all the states"
msgstr "B<all> - 表示所有状态"

#. type: Plain text
#: raw/iproute2/man8/ss.8:453
msgid "B<connected> - all the states except for B<listening> and B<closed>"
msgstr "B<connected> - 除 B<listening> 和 B<closed> 之外的所有状态"

#. type: Plain text
#: raw/iproute2/man8/ss.8:459
msgid "B<synchronized> - all the B<connected> states except for B<syn-sent>"
msgstr "B<synchronized> - 除 B<syn-sent> 之外的所有 B<connected> 状态"

#. type: Plain text
#: raw/iproute2/man8/ss.8:463
msgid ""
"B<bucket> - states, which are maintained as minisockets, i.e.  B<time-"
"wait> and B<syn-recv>"
msgstr "B<bucket> - 以 minisocket 形式维护的状态，即 B<time-wait> 和 B<syn-recv>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:467
msgid "B<big> - opposite to B<bucket>"
msgstr "B<big> - 与 B<bucket> 相反"

#. type: Plain text
#: raw/iproute2/man8/ss.8:470
msgid ""
"B<bound-inactive> - bound but otherwise inactive sockets (not listening, "
"connecting, etc.)"
msgstr "B<bound-inactive> - 已绑定但其他方面处于非活动状态的套接字（未监听、未连接等）"

#. type: SH
#: raw/iproute2/man8/ss.8:471
#, no-wrap
msgid "EXPRESSION"
msgstr "表达式"

#. type: Plain text
#: raw/iproute2/man8/ss.8:486
msgid ""
"B<EXPRESSION> allows filtering based on specific criteria.  B<EXPRESSION>"
" consists of a series of predicates combined by boolean operators. The "
"possible operators in increasing order of precedence are B<or> (or | or "
"||), B<and> (or & or &&), and B<not> (or !). If no operator is between "
"consecutive predicates, an implicit B<and> operator is assumed. "
"Subexpressions can be grouped with \"(\" and \")\"."
msgstr ""
"B<EXPRESSION> 允许基于特定条件进行过滤。B<EXPRESSION> "
"由一系列谓词组成，并通过布尔运算符组合。可用的运算符按优先级从低到高为 B<or>（或 | 或 ||）、B<and>（或 & 或 &&）和 "
"B<not>（或 !）。如果连续谓词之间没有运算符，则假定存在隐式的 B<and> 运算符。可以使用 \"(\" 和 \")\" "
"对子表达式进行分组。"

#. type: Plain text
#: raw/iproute2/man8/ss.8:488
msgid "The following predicates are supported:"
msgstr "支持以下谓词："

#. type: TP
#: raw/iproute2/man8/ss.8:489
#, no-wrap
msgid "B<{dst|src} [=] HOST>"
msgstr "B<{dst|src} [=] HOST>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:492
msgid ""
"Test if the destination or source matches HOST. See HOST SYNTAX for "
"details."
msgstr "测试目标或源是否匹配 HOST。详情参见“主机语法”。"

#. type: TP
#: raw/iproute2/man8/ss.8:492
#, no-wrap
msgid "B<{dport|sport} [OP] [FAMILY:]:PORT>"
msgstr "B<{dport|sport} [OP] [FAMILY:]:PORT>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:497
msgid ""
"Compare the destination or source port to PORT. OP can be any of "
"\"E<lt>\", \"E<lt>=\", \"=\", \"!=\", \"E<gt>=\" and \"E<gt>\", following"
" normal arithmetic rules. FAMILY and PORT are as described in HOST SYNTAX"
" below."
msgstr ""
"将目标或源端口与 PORT 进行比较。OP 可以是 \"E<lt>\"、\"E<lt>=\"、\"=\"、\"!=\"、\"E<gt>=\" 和 "
"\"E<gt>\" 中的任意一个，遵循常规算术规则。FAMILY 和 PORT 如下文“主机语法”所述。"

#. type: TP
#: raw/iproute2/man8/ss.8:497
#, no-wrap
msgid "B<dev [=|!=] DEVICE>"
msgstr "B<dev [=|!=] DEVICE>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:501
msgid ""
"Match based on the device the connection uses. DEVICE can either be a "
"device name or the index of the interface."
msgstr "根据连接使用的设备进行匹配。DEVICE 可以是设备名，也可以是接口索引。"

#. type: TP
#: raw/iproute2/man8/ss.8:501
#, no-wrap
msgid "B<fwmark [=|!=] MASK>"
msgstr "B<fwmark [=|!=] MASK>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:506
msgid ""
"Matches based on the fwmark value for the connection. This can either be "
"a specific mark value or a mark value followed by a \"/\" and a bitmask "
"of which bits to use in the comparison. For example \"fwmark = "
"0x01/0x03\" would match if the two least significant bits of the fwmark "
"were 0x01."
msgstr ""
"根据连接的 fwmark 值进行匹配。这可以是特定的标记值，也可以是标记值后跟 \"/\" 和用于比较的位掩码。例如，\"fwmark = "
"0x01/0x03\" 会在 fwmark 的最低两位为 0x01 时匹配。"

#. type: TP
#: raw/iproute2/man8/ss.8:506
#, no-wrap
msgid "B<cgroup [=|!=] PATH>"
msgstr "B<cgroup [=|!=] PATH>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:509
msgid "Match if the connection is part of a cgroup at the given path."
msgstr "如果连接属于给定路径的 cgroup，则匹配。"

#. type: TP
#: raw/iproute2/man8/ss.8:509
#, no-wrap
msgid "B<autobound>"
msgstr "B<autobound>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:513
msgid ""
"Match if the port or path of the source address was automatically "
"allocated (rather than explicitly specified)."
msgstr "如果源地址的端口或路径是自动分配的（而不是显式指定的），则匹配。"

#. type: Plain text
#: raw/iproute2/man8/ss.8:516
msgid ""
"Most operators have aliases. If no operator is supplied \"=\" is assumed."
"  Each of the following groups of operators are all equivalent:"
msgstr "大多数运算符都有别名。如果未提供运算符，则假定为 \"=\"。以下每组运算符都是等价的："

#. type: IP
#: raw/iproute2/man8/ss.8:517 raw/iproute2/man8/ss.8:519
#: raw/iproute2/man8/ss.8:521 raw/iproute2/man8/ss.8:523
#: raw/iproute2/man8/ss.8:525 raw/iproute2/man8/ss.8:527
#: raw/iproute2/man8/ss.8:529 raw/iproute2/man8/ss.8:531
#: raw/iproute2/man8/ss.8:533
#, no-wrap
msgid "\\(bu"
msgstr "\\(bu"

#. type: Plain text
#: raw/iproute2/man8/ss.8:519
msgid "= == eq"
msgstr "= == eq"

#. type: Plain text
#: raw/iproute2/man8/ss.8:521
msgid "!= ne neq"
msgstr "!= ne neq"

#. type: Plain text
#: raw/iproute2/man8/ss.8:523
msgid "E<gt> gt"
msgstr "E<gt> gt"

#. type: Plain text
#: raw/iproute2/man8/ss.8:525
msgid "E<lt> lt"
msgstr "E<lt> lt"

#. type: Plain text
#: raw/iproute2/man8/ss.8:527
msgid "E<gt>= ge geq"
msgstr "E<gt>= ge geq"

#. type: Plain text
#: raw/iproute2/man8/ss.8:529
msgid "E<lt>= le leq"
msgstr "E<lt>= le leq"

#. type: Plain text
#: raw/iproute2/man8/ss.8:531
msgid "! not"
msgstr "! not"

#. type: Plain text
#: raw/iproute2/man8/ss.8:533
msgid "| || or"
msgstr "| || or"

#. type: Plain text
#: raw/iproute2/man8/ss.8:535
msgid "& && and"
msgstr "& && and"

#. type: SH
#: raw/iproute2/man8/ss.8:536
#, no-wrap
msgid "HOST SYNTAX"
msgstr "主机语法"

#. type: Plain text
#: raw/iproute2/man8/ss.8:539
msgid "The general host syntax is [FAMILY:]ADDRESS[:PORT]."
msgstr "一般主机语法为 [FAMILY:]ADDRESS[:PORT]。"

#. type: Plain text
#: raw/iproute2/man8/ss.8:545
msgid ""
"FAMILY must be one of the families supported by the -f option. If not "
"given it defaults to the family given with the -f option, and if that is "
"also missing, will assume either inet or inet6. Note that all host "
"conditions in the expression should either all be the same family or be "
"only inet and inet6. If there is some other mixture of families, the "
"results will probably be unexpected."
msgstr ""
"FAMILY 必须是 -f 选项支持的类型之一。如果未给出，则默认为 -f 选项给出的类型；如果也没有，则假定为 inet 或 "
"inet6。请注意，表达式中的所有主机条件要么都属于同一类型，要么都只能是 inet 和 inet6。如果混合了其他类型，结果可能出乎意料。"

#. type: Plain text
#: raw/iproute2/man8/ss.8:549
msgid ""
"The form of ADDRESS and PORT depends on the family used. \"*\" can be "
"used as a wildcard for either the address or port. The details for each "
"family are as follows:"
msgstr "ADDRESS 和 PORT 的形式取决于所使用的类型。\"*\" 可以用作地址或端口的通配符。各类型的详细信息如下："

#. type: TP
#: raw/iproute2/man8/ss.8:549
#, no-wrap
msgid "B<unix>"
msgstr "B<unix>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:555
msgid ""
"ADDRESS is a glob pattern (see B<fnmatch>(3))  that will be matched case-"
"insensitively against the unix socket's address. Both path and abstract "
"names are supported. Unix addresses do not support a port, and \"*\" "
"cannot be used as a wildcard."
msgstr ""
"ADDRESS 是 glob 模式（参见 B<fnmatch>(3)），会以不区分大小写的方式与 Unix "
"套接字地址匹配。支持路径名和抽象名称。Unix 地址不支持端口，并且 \"*\" 不能用作通配符。"

#. type: TP
#: raw/iproute2/man8/ss.8:555
#, no-wrap
msgid "B<link>"
msgstr "B<link>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:560
msgid ""
"ADDRESS is the case-insensitive name of an Ethernet protocol to match. "
"PORT is either a device name or a device index for the desired link "
"device, as seen in the output of ip link."
msgstr "ADDRESS 是要匹配的以太网协议名称（不区分大小写）。PORT 是所需链路设备的设备名或设备索引，如 ip link 的输出所示。"

#. type: TP
#: raw/iproute2/man8/ss.8:560
#, no-wrap
msgid "B<netlink>"
msgstr "B<netlink>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:566
msgid ""
"ADDRESS is a descriptor of the netlink family. Possible values come from "
"/etc/iproute2/nl_protos. PORT is the port id of the socket, which is "
"usually the same as the owning process id. The value \"kernel\" can be "
"used to represent the kernel (port id of 0)."
msgstr ""
"ADDRESS 是 netlink 类型的描述符。可能的值来自 /etc/iproute2/nl_protos。PORT 是套接字的端口 "
"ID，通常与拥有该套接字的进程 ID 相同。值 \"kernel\" 可用于表示内核（端口 ID 为 0）。"

#. type: TP
#: raw/iproute2/man8/ss.8:566
#, no-wrap
msgid "B<vsock>"
msgstr "B<vsock>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:569
msgid "ADDRESS is an integer representing the CID address, and PORT is the port."
msgstr "ADDRESS 是表示 CID 地址的整数，PORT 是端口。"

#. type: TP
#: raw/iproute2/man8/ss.8:569
#, no-wrap
msgid "B<inet>\\ and\\ B<inet6>"
msgstr "B<inet>\\ and\\ B<inet6>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:577
msgid ""
"ADDRESS is an ip address (either v4 or v6 depending on the family) or a "
"DNS hostname that resolves to an ip address of the required version. An "
"ipv6 address must be enclosed in \"[\" and \"]\" to disambiguate the port"
" separator. The address may additionally have a prefix length given in "
"CIDR notation (a slash followed by the prefix length in bits). PORT is "
"either the numerical socket port, or the service name for the port to "
"match."
msgstr ""
"ADDRESS 是 IP 地址（根据类型为 v4 或 v6），或解析为所需版本 IP 地址的 DNS 主机名。IPv6 地址必须用 \"[\" 和"
" \"]\" 括起来，以消除端口分隔符的歧义。地址还可以带有 CIDR 表示法给出的前缀长度（斜杠后跟前缀长度位数）。PORT "
"可以是数字套接字端口，也可以是要匹配的端口服务名。"

#. type: SH
#: raw/iproute2/man8/ss.8:578
#, no-wrap
msgid "USAGE EXAMPLES"
msgstr "用法示例"

#. type: TP
#: raw/iproute2/man8/ss.8:579
#, no-wrap
msgid "B<ss -t -a>"
msgstr "B<ss -t -a>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:582
msgid "Display all TCP sockets."
msgstr "显示所有 TCP 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:582
#, no-wrap
msgid "B<ss -t -a -Z>"
msgstr "B<ss -t -a -Z>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:585
msgid "Display all TCP sockets with process SELinux security contexts."
msgstr "显示所有带进程 SELinux 安全上下文的 TCP 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:585
#, no-wrap
msgid "B<ss -u -a>"
msgstr "B<ss -u -a>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:588
msgid "Display all UDP sockets."
msgstr "显示所有 UDP 套接字。"

#. type: TP
#: raw/iproute2/man8/ss.8:588
#, no-wrap
msgid "B<ss -o state established '( dport = :ssh or sport = :ssh )'>"
msgstr "B<ss -o state established '( dport = :ssh or sport = :ssh )'>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:591
msgid "Display all established ssh connections."
msgstr "显示所有已建立的 ssh 连接。"

#. type: TP
#: raw/iproute2/man8/ss.8:591
#, no-wrap
msgid "B<ss -x src /tmp/.X11-unix/*>"
msgstr "B<ss -x src /tmp/.X11-unix/*>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:594
msgid "Find all local processes connected to X server."
msgstr "查找所有连接到 X 服务器的本地进程。"

#. type: TP
#: raw/iproute2/man8/ss.8:594
#, no-wrap
msgid ""
"B<ss -o state fin-wait-1 '( sport = :http or sport = :https )' dst "
"193.233.7/24>"
msgstr ""
"B<ss -o state fin-wait-1 '( sport = :http or sport = :https )' dst "
"193.233.7/24>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:598
msgid ""
"List all the tcp sockets in state FIN-WAIT-1 for our apache to network "
"193.233.7/24 and look at their timers."
msgstr "列出我们的 apache 到网络 193.233.7/24 的所有处于 FIN-WAIT-1 状态的 TCP 套接字，并查看它们的定时器。"

#. type: TP
#: raw/iproute2/man8/ss.8:598
#, no-wrap
msgid "B<ss -a -A 'all,!tcp'>"
msgstr "B<ss -a -A 'all,!tcp'>"

#. type: Plain text
#: raw/iproute2/man8/ss.8:601
msgid "List sockets in all states from all socket tables but TCP."
msgstr "列出所有套接字表中除 TCP 之外的所有状态套接字。"

#. type: SH
#: raw/iproute2/man8/ss.8:601
#, no-wrap
msgid "SEE ALSO"
msgstr "参见"

