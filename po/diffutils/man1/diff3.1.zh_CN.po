#. type: TH
#: raw/diffutils/man1/diff3.1:2
#, no-wrap
msgid "DIFF3"
msgstr "DIFF3"

#. type: TH
#: raw/diffutils/man1/diff3.1:2
#, no-wrap
msgid "April 2025"
msgstr "2025年四月"

#. type: TH
#: raw/diffutils/man1/diff3.1:2
#, no-wrap
msgid "diffutils 3.12"
msgstr "diffutils 3.12"

#. type: TH
#: raw/diffutils/man1/diff3.1:2
#, no-wrap
msgid "User Commands"
msgstr "用户命令"

#. type: SH
#: raw/diffutils/man1/diff3.1:3
#, no-wrap
msgid "NAME"
msgstr "名称"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:5
msgid "diff3 - compare three files line by line"
msgstr "diff3 - 逐行比较三个文件"

#. type: SH
#: raw/diffutils/man1/diff3.1:5
#, no-wrap
msgid "SYNOPSIS"
msgstr "概述"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:8
msgid "B<diff3> [I<\\,OPTION\\/>]... I<\\,MYFILE OLDFILE YOURFILE\\/>"
msgstr "B<diff3> [I<\\,选项\\/>]... I<\\,我的文件 旧文件 你的文件\\/>"

#. type: SH
#: raw/diffutils/man1/diff3.1:8
#, no-wrap
msgid "DESCRIPTION"
msgstr "描述"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:10
msgid "Compare three files line by line."
msgstr "逐行比较三个文件。"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:12
msgid ""
"Mandatory arguments to long options are mandatory for short options too."
msgstr "必选参数对长短选项同时适用。"

#. type: TP
#: raw/diffutils/man1/diff3.1:12
#, no-wrap
msgid "B<-A>, B<--show-all>"
msgstr "B<-A>, B<--show-all>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:15
msgid "output all changes, bracketing conflicts"
msgstr "输出所有更改，用方括号标注冲突"

#. type: TP
#: raw/diffutils/man1/diff3.1:15
#, no-wrap
msgid "B<-e>, B<--ed>"
msgstr "B<-e>, B<--ed>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:19
msgid ""
"output ed script incorporating changes from OLDFILE to YOURFILE into MYFILE"
msgstr "输出 ed 脚本，将从 旧文件 到 你的文件 的更改合并到 我的文件"

#. type: TP
#: raw/diffutils/man1/diff3.1:19
#, no-wrap
msgid "B<-E>, B<--show-overlap>"
msgstr "B<-E>, B<--show-overlap>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:22
msgid "like B<-e>, but bracket conflicts"
msgstr "类似于 B<-e>，但用方括号标注冲突"

#. type: TP
#: raw/diffutils/man1/diff3.1:22
#, no-wrap
msgid "B<-3>, B<--easy-only>"
msgstr "B<-3>, B<--easy-only>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:25
msgid "like B<-e>, but incorporate only nonoverlapping changes"
msgstr "类似于 B<-e>，但仅合并不重叠的更改"

#. type: TP
#: raw/diffutils/man1/diff3.1:25
#, no-wrap
msgid "B<-x>, B<--overlap-only>"
msgstr "B<-x>, B<--overlap-only>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:28
msgid "like B<-e>, but incorporate only overlapping changes"
msgstr "类似于 B<-e>，但仅合并重叠的更改"

#. type: TP
#: raw/diffutils/man1/diff3.1:28
#, no-wrap
msgid "B<-X>"
msgstr "B<-X>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:31
msgid "like B<-x>, but bracket conflicts"
msgstr "类似于 B<-x>，但用方括号标注冲突"

#. type: TP
#: raw/diffutils/man1/diff3.1:31
#, no-wrap
msgid "B<-i>"
msgstr "B<-i>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:34
msgid "append 'w' and 'q' commands to ed scripts"
msgstr "将 'w' 和 'q' 命令追加到 ed 脚本"

#. type: TP
#: raw/diffutils/man1/diff3.1:34
#, no-wrap
msgid "B<-m>, B<--merge>"
msgstr "B<-m>, B<--merge>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:38
msgid ""
"output actual merged file, according to B<-A> if no other options are given"
msgstr "输出实际合并后的文件，如果没有给出其他选项则按 B<-A> 进行"

#. type: TP
#: raw/diffutils/man1/diff3.1:38
#, no-wrap
msgid "B<-a>, B<--text>"
msgstr "B<-a>, B<--text>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:41
msgid "treat all files as text"
msgstr "将所有文件视为文本"

#. type: TP
#: raw/diffutils/man1/diff3.1:41
#, no-wrap
msgid "B<--strip-trailing-cr>"
msgstr "B<--strip-trailing-cr>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:44
msgid "strip trailing carriage return on input"
msgstr "去除输入行尾的回车符"

#. type: TP
#: raw/diffutils/man1/diff3.1:44
#, no-wrap
msgid "B<-T>, B<--initial-tab>"
msgstr "B<-T>, B<--initial-tab>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:47
msgid "make tabs line up by prepending a tab"
msgstr "通过在行首添加制表符来对齐制表符"

#. type: TP
#: raw/diffutils/man1/diff3.1:47
#, no-wrap
msgid "B<--diff-program>=I<\\,PROGRAM\\/>"
msgstr "B<--diff-program>=I<\\,程序\\/>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:50
msgid "use PROGRAM to compare files"
msgstr "使用指定程序来比较文件"

#. type: TP
#: raw/diffutils/man1/diff3.1:50
#, no-wrap
msgid "B<-L>, B<--label>=I<\\,LABEL\\/>"
msgstr "B<-L>, B<--label>=I<\\,标签\\/>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:54
msgid "use LABEL instead of file name (can be repeated up to three times)"
msgstr "使用给定标签代替文件名（最多可重复三次）"

#. type: TP
#: raw/diffutils/man1/diff3.1:54
#, no-wrap
msgid "B<--help>"
msgstr "B<--help>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:57
msgid "display this help and exit"
msgstr "显示此帮助信息并退出"

#. type: TP
#: raw/diffutils/man1/diff3.1:57
#, no-wrap
msgid "B<-v>, B<--version>"
msgstr "B<-v>, B<--version>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:60
msgid "output version information and exit"
msgstr "显示版本信息并退出"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:63
msgid ""
"The default output format is a somewhat human-readable representation of the "
"changes."
msgstr "默认输出格式是较为易读的文件修改表示。"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:66
msgid ""
"The B<-e>, B<-E>, B<-x>, B<-X> (and corresponding long) options cause an ed "
"script to be output instead of the default."
msgstr ""
"B<-e>, B<-e>, B<-x>, B<-X>（及相应的长选项）会导致输出 ed 脚本而非默认格式。"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:70
msgid ""
"Finally, the B<-m> (B<--merge>) option causes diff3 to do the merge "
"internally and output the actual merged file.  For unusual input, this is "
"more robust than using ed."
msgstr ""
"最后，B<-m>（B<--merge>）选项会使 diff3 在内部执行合并并输出实际合并后的文"
"件。对于不寻常的输入，这比使用 ed 更加可靠。"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:73
msgid ""
"If a FILE is '-', read standard input.  Exit status is 0 if successful, 1 if "
"conflicts, 2 if trouble."
msgstr ""
"如果 文件 为 '-' 或缺失，则从标准输入读取。如果成功则退出状态为 0，有冲突为 "
"1，出错为 2。"

#. type: SH
#: raw/diffutils/man1/diff3.1:73
#, no-wrap
msgid "AUTHOR"
msgstr "作者"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:75
msgid "Written by Randy Smith."
msgstr "由 Randy Smith 编写。"

#. type: SH
#: raw/diffutils/man1/diff3.1:75
#, no-wrap
msgid "REPORTING BUGS"
msgstr "报告错误"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:77
msgid "Report bugs to: bug-diffutils@gnu.org"
msgstr "请将程序缺陷报告至：bug-diffutils@gnu.org"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:79
msgid ""
"GNU diffutils home page: E<lt>https://www.gnu.org/software/diffutils/E<gt>"
msgstr "GNU diffutils 主页：E<lt>https://www.gnu.org/software/diffutils/E<gt>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:81
msgid "General help using GNU software: E<lt>https://www.gnu.org/gethelp/E<gt>"
msgstr "GNU 软件的通用帮助：E<lt>https://www.gnu.org/gethelp/E<gt>"

#. type: SH
#: raw/diffutils/man1/diff3.1:81
#, no-wrap
msgid "COPYRIGHT"
msgstr "版权"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:84
msgid ""
"Copyright \\(co 2025 Free Software Foundation, Inc.  License GPLv3+: GNU GPL "
"version 3 or later E<lt>https://gnu.org/licenses/gpl.htmlE<gt>."
msgstr ""
"版权所有 \\(co 2025 自由软件基金会。许可证 GPLv3+：GNU GPL 第 3 版或更新版本 "
"E<lt>https://gnu.org/licenses/gpl.htmlE<gt>。"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:87
msgid ""
"This is free software: you are free to change and redistribute it.  There is "
"NO WARRANTY, to the extent permitted by law."
msgstr ""
"这是自由软件：您可以自由地更改并对其重新发布。在法律所允许的范围内不含任何担"
"保。"

#. type: SH
#: raw/diffutils/man1/diff3.1:87
#, no-wrap
msgid "SEE ALSO"
msgstr "亦见"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:91
msgid "B<cmp>(1), B<diff>(1), B<sdiff>(1)"
msgstr "B<cmp>(1), B<diff>(1), B<sdiff>(1)"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:99
msgid ""
"The full documentation for B<diff3> is maintained as a Texinfo manual.  If "
"the B<info> and B<diff3> programs are properly installed at your site, the "
"command"
msgstr ""
"B<diff3> 的完整文档以 Texinfo 手册形式维护。如果你的系统上正确安装了 B<info> "
"和 B<diff3> 程序，命令"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:101
msgid "B<info diff3>"
msgstr "B<info diff3>"

#. type: Plain text
#: raw/diffutils/man1/diff3.1:102
msgid "should give you access to the complete manual."
msgstr "应该可以让你访问完整的手册。"
