#: raw/diffutils/man1/cmp.1:55
msgid "General help using GNU software: E<lt>https://www.gnu.org/gethelp/E<gt>"
msgstr "GNU 软件的通用帮助：E<lt>https://www.gnu.org/gethelp/E<gt>"

