#. type: TH
#: raw/diffutils/man1/cmp.1:2
#, no-wrap
msgid "CMP"
msgstr "CMP"

#. type: TH
#: raw/diffutils/man1/cmp.1:2
#, no-wrap
msgid "April 2025"
msgstr "2025年四月"

#. type: TH
#: raw/diffutils/man1/cmp.1:2
#, no-wrap
msgid "diffutils 3.12"
msgstr "diffutils 3.12"

#. type: TH
#: raw/diffutils/man1/cmp.1:2
#, no-wrap
msgid "User Commands"
msgstr "用户命令"

#. type: SH
#: raw/diffutils/man1/cmp.1:3
#, no-wrap
msgid "NAME"
msgstr "名称"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:5
msgid "cmp - compare two files byte by byte"
msgstr "cmp - 逐字节比较两个文件"

#. type: SH
#: raw/diffutils/man1/cmp.1:5
#, no-wrap
msgid "SYNOPSIS"
msgstr "概述"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:8
msgid ""
"B<cmp> [I<\\,OPTION\\/>]... I<\\,FILE1 \\/>[I<\\,FILE2 \\/>[I<\\,SKIP1 \\/"
">[I<\\,SKIP2\\/>]]]"
msgstr ""
"B<cmp> [I<\\,选项\\/>]... I<\\,文件1 \\/>[I<\\,文件2 \\/>[I<\\,跳过1 \\/"
">[I<\\,跳过2\\/>]]]"

#. type: SH
#: raw/diffutils/man1/cmp.1:8
#, no-wrap
msgid "DESCRIPTION"
msgstr "描述"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:10
msgid "Compare two files byte by byte."
msgstr "逐字节比较两个文件。"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:13
msgid ""
"The optional SKIP1 and SKIP2 specify the number of bytes to skip at the "
"beginning of each file (zero by default)."
msgstr "可选的 跳过1 和 跳过2 分别指定每个文件开头要跳过的字节数（默认为零）。"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:15
msgid ""
"Mandatory arguments to long options are mandatory for short options too."
msgstr "必选参数对长短选项同时适用。"

#. type: TP
#: raw/diffutils/man1/cmp.1:15
#, no-wrap
msgid "B<-b>, B<--print-bytes>"
msgstr "B<-b>, B<--print-bytes>"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:18
msgid "print differing bytes"
msgstr "打印不同的字节"

#. type: TP
#: raw/diffutils/man1/cmp.1:18
#, no-wrap
msgid "B<-i>, B<--ignore-initial>=I<\\,SKIP\\/>"
msgstr "B<-i>, B<--ignore-initial>=I<\\,跳过\\/>"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:21
msgid "skip first SKIP bytes of both inputs"
msgstr "同时跳过两个输入文件的前 跳过 个字节"

#. type: TP
#: raw/diffutils/man1/cmp.1:21
#, no-wrap
msgid "B<-i>, B<--ignore-initial>=I<\\,SKIP1\\/>:SKIP2"
msgstr "B<-i>, B<--ignore-initial>=I<\\,跳过1\\/>:跳过2"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:25
msgid "skip first SKIP1 bytes of FILE1 and first SKIP2 bytes of FILE2"
msgstr "跳过 文件1 的前 跳过1 个字节和 文件2 的前 跳过2 个字节"

#. type: TP
#: raw/diffutils/man1/cmp.1:25
#, no-wrap
msgid "B<-l>, B<--verbose>"
msgstr "B<-l>, B<--verbose>"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:28
msgid "output byte numbers and differing byte values"
msgstr "输出字节编号和不同的字节值"

#. type: TP
#: raw/diffutils/man1/cmp.1:28
#, no-wrap
msgid "B<-n>, B<--bytes>=I<\\,LIMIT\\/>"
msgstr "B<-n>, B<--bytes>=I<\\,限制\\/>"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:31
msgid "compare at most LIMIT bytes"
msgstr "最多比较指定数量的字节"

#. type: TP
#: raw/diffutils/man1/cmp.1:31
#, no-wrap
msgid "B<-s>, B<--quiet>, B<--silent>"
msgstr "B<-s>, B<--quiet>, B<--silent>"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:34
msgid "suppress all normal output"
msgstr "禁止所有通常输出"

#. type: TP
#: raw/diffutils/man1/cmp.1:34
#, no-wrap
msgid "B<--help>"
msgstr "B<--help>"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:37
msgid "display this help and exit"
msgstr "显示此帮助信息并退出"

#. type: TP
#: raw/diffutils/man1/cmp.1:37
#, no-wrap
msgid "B<-v>, B<--version>"
msgstr "B<-v>, B<--version>"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:40
msgid "output version information and exit"
msgstr "显示版本信息并退出"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:44
msgid ""
"SKIP values may be followed by the following multiplicative suffixes: kB "
"1000, K 1024, MB 1,000,000, M 1,048,576, GB 1,000,000,000, G 1,073,741,824, "
"and so on for T, P, E, Z, Y."
msgstr ""
"跳过 的值后面可以附上以下的单位后缀：kB 1000、K 1,024、MB 1,000,000、M "
"1,048,576、GB 1,000,000,000、G=107,073,741,824，还有 T、P、E、Z、Y，如此类"
"推。"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:47
msgid ""
"If a FILE is '-' or missing, read standard input.  Exit status is 0 if "
"inputs are the same, 1 if different, 2 if trouble."
msgstr ""
"如果 文件 为 '-' 或缺失，则从标准输入读取。如果输入相同则退出状态为 0，不同"
"为 1，出错为 2。"

#. type: SH
#: raw/diffutils/man1/cmp.1:47
#, no-wrap
msgid "AUTHOR"
msgstr "作者"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:49
msgid "Written by Torbjorn Granlund and David MacKenzie."
msgstr "由 Torbjorn Granlund 和 David MacKenzie 编写。"

#. type: SH
#: raw/diffutils/man1/cmp.1:49
#, no-wrap
msgid "REPORTING BUGS"
msgstr "报告错误"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:51
msgid "Report bugs to: bug-diffutils@gnu.org"
msgstr "请将程序缺陷报告至：bug-diffutils@gnu.org"

#. type: Plain text
#: raw/diffutils/man1/cmp.1:53
msgid ""
"GNU diffutils home page: E<lt>https://www.gnu.org/software/diffutils/E<gt>"
msgstr "GNU diffutils 主页：E<lt>https://www.gnu.org/software/diffutils/E<gt>"

