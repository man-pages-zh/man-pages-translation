msgid "NAME"
msgstr ""

#. type: Plain text
#: raw/iproute2/man8/ss.8:4
msgid "ss - another utility to investigate sockets"
msgstr ""

#. type: SH
#: raw/iproute2/man8/ss.8:4
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: raw/iproute2/man8/ss.8:7
msgid "B<ss> [I<options>]I< [ FILTER ]>"
msgstr ""

