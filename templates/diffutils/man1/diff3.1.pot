#, no-wrap
msgid "DIFF3"
msgstr ""

#. type: TH
#: raw/diffutils/man1/diff3.1:2
#, no-wrap
msgid "April 2025"
msgstr ""

#. type: TH
#: raw/diffutils/man1/diff3.1:2
#, no-wrap
msgid "diffutils 3.12"
msgstr ""

#. type: TH
#: raw/diffutils/man1/diff3.1:2
#, no-wrap
msgid "User Commands"
msgstr ""

#. type: SH
#: raw/diffutils/man1/diff3.1:3
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:5
msgid "diff3 - compare three files line by line"
msgstr ""

#. type: SH
#: raw/diffutils/man1/diff3.1:5
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:8
msgid "B<diff3> [I<\\,OPTION\\/>]... I<\\,MYFILE OLDFILE YOURFILE\\/>"
msgstr ""

#. type: SH
#: raw/diffutils/man1/diff3.1:8
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:10
msgid "Compare three files line by line."
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:12
msgid ""
"Mandatory arguments to long options are mandatory for short options too."
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:12
#, no-wrap
msgid "B<-A>, B<--show-all>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:15
msgid "output all changes, bracketing conflicts"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:15
#, no-wrap
msgid "B<-e>, B<--ed>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:19
msgid ""
"output ed script incorporating changes from OLDFILE to YOURFILE into MYFILE"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:19
#, no-wrap
msgid "B<-E>, B<--show-overlap>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:22
msgid "like B<-e>, but bracket conflicts"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:22
#, no-wrap
msgid "B<-3>, B<--easy-only>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:25
msgid "like B<-e>, but incorporate only nonoverlapping changes"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:25
#, no-wrap
msgid "B<-x>, B<--overlap-only>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:28
msgid "like B<-e>, but incorporate only overlapping changes"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:28
#, no-wrap
msgid "B<-X>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:31
msgid "like B<-x>, but bracket conflicts"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:31
#, no-wrap
msgid "B<-i>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:34
msgid "append 'w' and 'q' commands to ed scripts"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:34
#, no-wrap
msgid "B<-m>, B<--merge>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:38
msgid ""
"output actual merged file, according to B<-A> if no other options are given"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:38
#, no-wrap
msgid "B<-a>, B<--text>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:41
msgid "treat all files as text"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:41
#, no-wrap
msgid "B<--strip-trailing-cr>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:44
msgid "strip trailing carriage return on input"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:44
#, no-wrap
msgid "B<-T>, B<--initial-tab>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:47
msgid "make tabs line up by prepending a tab"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:47
#, no-wrap
msgid "B<--diff-program>=I<\\,PROGRAM\\/>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:50
msgid "use PROGRAM to compare files"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:50
#, no-wrap
msgid "B<-L>, B<--label>=I<\\,LABEL\\/>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:54
msgid "use LABEL instead of file name (can be repeated up to three times)"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:54
#, no-wrap
msgid "B<--help>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:57
msgid "display this help and exit"
msgstr ""

#. type: TP
#: raw/diffutils/man1/diff3.1:57
#, no-wrap
msgid "B<-v>, B<--version>"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:60
msgid "output version information and exit"
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:63
msgid ""
"The default output format is a somewhat human-readable representation of the "
"changes."
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:66
msgid ""
"The B<-e>, B<-E>, B<-x>, B<-X> (and corresponding long) options cause an ed "
"script to be output instead of the default."
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:70
msgid ""
"Finally, the B<-m> (B<--merge>) option causes diff3 to do the merge "
"internally and output the actual merged file.  For unusual input, this is "
"more robust than using ed."
msgstr ""

#. type: Plain text
#: raw/diffutils/man1/diff3.1:73
msgid ""
"If a FILE is '-', read standard input.  Exit status is 0 if successful, 1 if "
"conflicts, 2 if trouble."
msgstr ""

